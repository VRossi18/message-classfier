# Copie para ".env" (ignorado pelo git) e preencha. O podman compose lê este arquivo na raiz.
# Provedor do classificador: fake (padrão, sem custo) | anthropic | ollama
LLM_PROVIDER=anthropic
# Chave da Anthropic. Só o serviço "worker" recebe esta variável.
ANTHROPIC_API_KEY=
# Modelo (padrão: Haiku 4.5, rápido e barato para classificar)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Limites opcionais
LLM_TIMEOUT_MS=30000
LLM_CONCURRENCY=5
CONFIDENCE_THRESHOLD=0.5
